digraph ClassPartial {
    rankdir=BT;
    node [shape=record, fontname="Arial"];

    ApprovalRoute [label="{\<\<enumeration\>\>\nApprovalRoute|STANDARD\lFAST_TRACK\lFINANCE_REVIEW\lDIRECTOR_REVIEW\lSECURITY_REVIEW\l}"];
    RiskLevel [label="{\<\<enumeration\>\>\nRiskLevel|LOW\lMEDIUM\lHIGH\l}"];
    ApprovalRouter [label="{ApprovalRouter|+ FINANCE_LIMIT : long = 500000L\l|+ route(...) : ApprovalRoute\l// TODO: реализация и методы варианта\l}"];
    SelfCheck [label="{SelfCheck||+ main(args : String[]) : void\l}"];

    ApprovalRouter -> ApprovalRoute [style=dashed, label="returns"];
    ApprovalRouter -> RiskLevel [style=dashed, label="uses"];
    SelfCheck -> ApprovalRouter [style=dashed, label="tests"];
}
