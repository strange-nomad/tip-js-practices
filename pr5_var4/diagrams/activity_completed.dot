digraph ActivityCompleted {
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Arial"];
    edge [fontname="Arial"];

    start [shape=circle, label="Начало", style=filled, fillcolor="#d4edda"];
    end [shape=doublecircle, label="Завершение", style=filled, fillcolor="#d4edda"];

    n1 [label="Получить входную строку табеля"];
    n2 [label="Разделить строку через split(';', -1)"];
    n3 [shape=diamond, label="parts.length == 5?"];
    n4 [label="Валидация каждого элемента:\nregex ^(0|[1-9][0-9]*)$ и диапазон [0, 16],\nпреобразование в int[] hours", style="rounded,filled", fillcolor="#d4edda"];
    n5 [shape=diamond, label="Все элементы корректны?"];
    n6 [label="Вычислить показатели:\ntotal (ненулевые дни, Вар. 4),\naverage (2 знака), overtimeDays (>8),\nweeklyOvertime, addWorkingDaysCount", style="rounded,filled", fillcolor="#d4edda"];
    n7 [label="Сформировать итоговый отчёт:\nсумма, среднее, переработка,\nчисло фактически отработанных дней", style="rounded,filled", fillcolor="#d4edda"];
    n8 [label="Сформировать сообщение об ошибке:\nуказать позицию или структуру (fail-fast)", style="rounded,filled", fillcolor="#f8d7da"];

    start -> n1;
    n1 -> n2;
    n2 -> n3;
    n3 -> n8 [label="нет"];
    n3 -> n4 [label="да"];
    n4 -> n5;
    n5 -> n8 [label="нет"];
    n5 -> n6 [label="да"];
    n6 -> n7;
    n7 -> end;
    n8 -> end;
}
