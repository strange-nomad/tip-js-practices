digraph ActivityPartial {
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Arial"];
    edge [fontname="Arial"];

    start [shape=circle, label="Начало", style=filled, fillcolor=lightgray];
    end [shape=doublecircle, label="Завершение", style=filled, fillcolor=lightgray];

    n1 [label="Получить строку часов"];
    n2 [label="Разделить строку на элементы (split)"];
    n3 [shape=diamond, label="Ровно пять значений?"];
    n4 [label="TODO A1:\nПреобразовать и проверить каждый элемент", style="rounded,filled", fillcolor="#ffcccc"];
    n5 [shape=diamond, label="Все элементы корректны?"];
    n6 [label="Вычислить сумму, среднее и переработку"];
    n7 [label="TODO A2:\nСформировать итоговый отчёт", style="rounded,filled", fillcolor="#ffcccc"];
    n8 [label="Сформировать сообщение об ошибке"];

    start -> n1;
    n1 -> n2;
    n2 -> n3;
    n3 -> n8 [label="нет"];
    n3 -> n4 [label="да"];
    n4 -> n5;
    n5 -> n8 [label="нет"];
    n5 -> n6 [label="да"];
    n6 -> n7;
    n7 -> end;
    n8 -> end;
}
